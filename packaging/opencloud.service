# Unité d'openCloud, posée par le paquet .deb. Durcie : le service ne voit le
# système qu'en lecture, sauf son répertoire d'état. Piège connu (Headscale
# #1274) : ProtectSystem=strict verrouille SQLite si l'état n'est pas déclaré
# en écriture — d'où StateDirectory= et ReadWritePaths= explicites.
[Unit]
Description=openCloud
Documentation=https://github.com/ldesfontaine/opencloud
After=network-online.target
Wants=network-online.target

# Redémarrages bornés. Sans ces deux clés, les défauts de systemd (5 démarrages
# en 10 s) ne sont jamais atteints à RestartSec=5s : le service repart sans fin,
# et chaque démarrage recopie la base entière dans backups/ avant de retenter la
# migration qui vient d'échouer — /var/lib se remplit et emporte les autres
# services. openCloud n'est pas indispensable : au cinquième échec il s'arrête,
# et l'opérateur lit « failed » dans systemctl status.
# 120 s couvre cinq tentatives à RestartSec=5s (25 s) avec de la marge pour la
# sauvegarde de chacune. Pas plus : systemd compte aussi les démarrages voulus —
# apt, needrestart, l'opérateur —, et une fenêtre large ferait renoncer l'unité
# sur une journée normale. Poser le paquet rend son budget à l'unité (postinst).
StartLimitBurst=5
StartLimitIntervalSec=120

[Service]
Type=notify
NotifyAccess=main
User=opencloud
Group=opencloud
ExecStart=/opt/opencloud/bin/opencloud serve --config /etc/opencloud/config.toml
Restart=on-failure
RestartSec=5s
# Le démarrage sauvegarde la base puis joue les migrations avant d'écouter.
# Ce délai est la référence des deux délais de self-update, qui le citent :
# selfupdate.UnitStartTimeout (internal/selfupdate/restart.go). Un test Go
# vérifie que les deux ne dérivent pas l'un de l'autre.
TimeoutStartSec=120s
TimeoutStopSec=30s
UMask=0077

# L'état : créé et possédé par l'utilisateur du service, en 0700.
StateDirectory=opencloud
StateDirectoryMode=0700
ReadWritePaths=/var/lib/opencloud

# Durcissement. Le service n'a besoin d'aucun privilège : il écoute un port
# haut, écrit dans son état, parle à systemd par sd_notify.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
