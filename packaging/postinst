#!/bin/sh
# Après la pose des fichiers par dpkg : l'utilisateur système, les droits,
# l'unité. $1 vaut "configure" ; $2 est la version précédente, vide à la
# première installation.
set -e

USER_NAME=opencloud
STATE_DIR=/var/lib/opencloud
CONFIG_FILE=/etc/opencloud/config.toml
UNIT=opencloud.service

# deb-systemd-invoke respecte policy-rc.d (conteneurs, images en construction) ;
# systemctl reste la voie de secours.
invoke_unit() {
    if command -v deb-systemd-invoke >/dev/null 2>&1; then
        deb-systemd-invoke "$1" "$UNIT"
    else
        systemctl "$1" "$UNIT"
    fi
}

# deb-systemd-helper lève le masque posé par apt remove, puis active l'unité —
# sauf si l'opérateur l'avait désactivée lui-même : il garde ce choix.
enable_unit() {
    if command -v deb-systemd-helper >/dev/null 2>&1; then
        deb-systemd-helper unmask "$UNIT" >/dev/null || true
        if deb-systemd-helper --quiet was-enabled "$UNIT"; then
            deb-systemd-helper enable "$UNIT" >/dev/null || true
        else
            deb-systemd-helper update-state "$UNIT" >/dev/null || true
        fi
    else
        systemctl enable "$UNIT"
    fi
}

case "$1" in
    configure)
        mkdir -p "$STATE_DIR"
        if ! getent passwd "$USER_NAME" >/dev/null; then
            adduser --system --group --home "$STATE_DIR" --no-create-home \
                --shell /usr/sbin/nologin --gecos "openCloud" "$USER_NAME"
        fi
        chown "$USER_NAME:$USER_NAME" "$STATE_DIR"
        chmod 0700 "$STATE_DIR"

        # Lisible par le service, modifiable par root seul : il contient un jeton.
        chown "root:$USER_NAME" "$CONFIG_FILE"
        chmod 0640 "$CONFIG_FILE"

        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload
            enable_unit
            # Première installation : start. Mise à jour ou réinstallation
            # après apt remove : restart, qui démarre aussi une unité arrêtée.
            # deb-systemd-invoke ne touche pas à une unité désactivée.
            if [ -z "$2" ]; then
                invoke_unit start
            else
                invoke_unit restart
            fi
        fi
        ;;
esac

exit 0
