# /etc/systemd/system/opencloud-agent.service — l'agent d'une machine, la
# machine openCloud comprise.
# À activer APRÈS le premier lancement (enrôlement : -server, jeton sur l'entrée
# standard).
[Unit]
Description=openCloud (agent)
Documentation=https://github.com/ldesfontaine/opencloud/blob/dev/docs/installation.md
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
# root : l'agent lit /proc, chaque volume monté et la socket Docker.
# -state doit être celui du premier lancement. Ajoutez ici -allow-plain,
# -ca-file ou -docker-socket s'ils servaient au premier lancement : ils ne
# sont pas retenus. -server, -pin et -lang le sont, inutile de les
# redonner.
ExecStart=/usr/local/bin/opencloud agent -state /var/lib/opencloud/agent
Restart=on-failure
RestartSec=10
# Code 2 : refus (machine retirée, identité refusée, pas enrôlée). Relancer
# n'y changerait rien ; il faut un nouveau jeton.
RestartPreventExitStatus=2
# Durcissement : root reste root, mais un agent compromis ne réécrit ni le
# système ni les comptes. Il lit /proc, les volumes, /root/.docker (les
# identifiants des registres) et la socket Docker ; il n'écrit que dans
# son état, qui doit exister (premier lancement fait).
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/opencloud/agent
ProtectHome=read-only
PrivateTmp=true
UMask=0077
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
# AF_NETLINK : la liste des interfaces réseau de la machine.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
