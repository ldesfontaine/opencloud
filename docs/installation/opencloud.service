# /etc/systemd/system/opencloud.service — le serveur openCloud.
[Unit]
Description=openCloud (serveur)
Documentation=https://github.com/ldesfontaine/opencloud/blob/dev/docs/installation.md
# Docker d'abord : si `listen` vise l'IP du pont docker0, elle doit exister.
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=opencloud
Group=opencloud
# Lire la socket Docker. Sans Docker sur la machine, supprimez cette ligne.
SupplementaryGroups=docker
ExecStart=/usr/local/bin/opencloud serve -config /etc/opencloud/config.toml
Restart=on-failure
RestartSec=5
# Crée /var/lib/opencloud en 0700, propriété de opencloud.
StateDirectory=opencloud
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
# strict : tout est en lecture seule, sauf StateDirectory. Un state_dir
# ailleurs que /var/lib/opencloud demande son ReadWritePaths.
ProtectSystem=strict
ProtectHome=read-only
# Le port 8080 n'exige aucune capacité.
CapabilityBoundingSet=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
# AF_NETLINK : la liste des interfaces, pour son rôle d'agent.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
